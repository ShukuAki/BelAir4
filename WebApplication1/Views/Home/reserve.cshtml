<!-- HERO SECTION -->
<section class="hero-section">
  <div class="hero-inner">
    <h1 class="hero-title">Reserve an Amenity</h1>
    <p class="hero-sub">Book village facilities for your events, practices or gatherings<br>quick and easy online reservation.</p>
  </div>
</section>

<!-- MAIN CONTENT -->
<main class="main-content">
  
  <!-- Tabs -->
  <div class="tabs-container">
    <button class="tab-btn active" data-amenity="Basketball Court">
      <i class="fas fa-basketball-ball"></i> Basketball Court
    </button>
    <button class="tab-btn" data-amenity="Multi-Purpose Hall">
      <i class="fas fa-building"></i> Multi-Purpose Hall
    </button>
  </div>

  <!-- Single Column Form -->
  <div class="form-wrapper">
    <div class="form-card">
      <h2 class="form-card-title">Reservation Details</h2>
      
      <form id="reservationForm">
        <div class="form-group">
          <label>Selected Amenity <span class="required">*</span></label>
          <input type="text" id="selectedAmenity" readonly class="readonly-input">
        </div>

        <div class="form-group">
          <label>Reservation Date <span class="required">*</span></label>
          <input type="text" id="datePicker" placeholder="Click to select a date" readonly>
          <div class="calendar-legend-inline">
            <span class="legend-dot available"></span> Available
            <span class="legend-dot user-pending"></span> Your Pending
            <span class="legend-dot user-approved"></span> Your Approved
            <span class="legend-dot unavailable"></span> Unavailable
          </div>
          <small class="form-hint"><i class="fas fa-info-circle"></i> Click the date field to open calendar</small>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Start Time <span class="required">*</span></label>
            <select id="startTime" class="time-select" disabled>
              <option value="">Select date first</option>
            </select>
          </div>
          <div class="form-group">
            <label>End Time <span class="required">*</span></label>
            <select id="endTime" class="time-select" disabled>
              <option value="">Select start time first</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Purpose of Reservation <span class="required">*</span></label>
          <select id="purpose" required>
            <option value="">Select a purpose</option>
            <option value="Practice">Practice</option>
            <option value="Event">Event</option>
            <option value="Meeting">Meeting</option>
            <option value="Celebration">Celebration</option>
            <option value="Others">Others</option>
          </select>
        </div>

        <div class="form-group">
          <label>Additional Notes</label>
          <textarea id="notes" rows="3" placeholder="Any special requests or additional information..."></textarea>
        </div>

        <div class="terms-section">
          <h4>Terms and Reminders</h4>
          <ul>
            <li>Reservations are subject to approval by the HOA.</li>
            <li>Please follow village rules and regulations when using the facility.</li>
            <li>Any damages to the facility may result in penalties.</li>
            <li>Payment for the reservation must be made at the HOA Office.</li>
            <li>Maximum of <strong>2 reservations per day</strong> per homeowner.</li>
            <li>Bookings can only be made up to <strong>14 days</strong> in advance.</li>
          </ul>
        </div>

        <div class="checkbox-group">
          <input type="checkbox" id="agreeTerms" required>
          <label for="agreeTerms">I agree to the terms and conditions. <span class="required">*</span></label>
        </div>

        <button type="submit" class="submit-btn">Submit Reservation Request</button>
      </form>
    </div>
  </div>
</main>

