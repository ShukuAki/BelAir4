@{
    var username = Context.Session.GetString("Username");
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reserve Amenities - Laguna BelAir 4</title>
<!-- Fonts: Playfair Display + Outfit -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<!-- Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- Flatpickr CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<!-- Styles -->
<link rel="stylesheet" href="/css/reserve.css">
</head>
<body>

    <!-- ═══════════════════════════════════════
          HEADER / NAV (updated to match advertisements style)
        ═════════════════════════════════════ -->
    <div class="top-header-container">
        <!-- Logo Section -->
        <div class="logo-section">
            <a asp-controller="Home" asp-action="Index" class="logo-link">
                <img src="@(Url.Content("~/assets/LBAlogo.png"))" alt="Bel-Air Village Logo" class="logo-image">
            </a>
        </div>
        <!-- Navbar Wrapper -->
        <div class="header-center-wrapper">
            <div class="navbar-two-rows">
                <!-- Top Row: Utility Links -->
                <div class="navbar-top-row">
                    @if (!string.IsNullOrEmpty(username))
                    {
                        <span class="nav-user">Hello, @username</span>
                        <form id="logoutForm" method="post" asp-controller="Home" asp-action="Logout" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-link btn-logout">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="login"><i class="fas fa-sign-in-alt"></i> Login</a>
                        <span class="nav-separator">|</span>
                        <a asp-controller="Home" asp-action="register"><i class="fas fa-user-plus"></i> Register</a>
                    }
                </div>
                <!-- Bottom Row: Main Navigation -->
                <div class="navbar-bottom-row">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">About <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                            <a asp-controller="Home" asp-action="aboutlagunabelair">Laguna BelAir 4</a>
                            <a asp-controller="Home" asp-action="committeesbods">Committees/BODs</a>
                            <a asp-controller="Home" asp-action="landmarks">Landmarks</a>
                            <a asp-controller="Home" asp-action="contacts">Contacts</a>
                        </div>
                    </div>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">Community <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                            <a asp-controller="Home" asp-action="announcement">Announcements</a>
                            <a asp-controller="Home" asp-action="forums">Forums/Discussions</a>
                            <a asp-controller="Home" asp-action="advertisements">Community Exchange</a>
                            <a asp-controller="Home" asp-action="calendars">Calendars</a>
                            <a asp-controller="Home" asp-action="meetingagendas">Meeting Record/Governance</a>
                            <a asp-controller="Home" asp-action="communitymap">Community Map</a>
                        </div>
                    </div>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">Services <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                             <a asp-controller="Home" asp-action="reserve">Reserve Amenities</a>
                            <a asp-controller="Home" asp-action="reportConcerns">Report Concerns/Incidents</a>
                        </div>
                    </div>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">Others <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                            <a asp-controller="Home" asp-action="formsDocuments">Downloadable Forms and Documents</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- HERO SECTION -->
<section class="hero-section">
  <div class="hero-inner">
    <h1 class="hero-title">Reserve an Amenity</h1>
    <p class="hero-sub">Book village facilities for your events, practices or gatherings<br>quick and easy online reservation.</p>
  </div>
</section>

<!-- MAIN CONTENT -->
<main class="main-content">
  
  <!-- Tabs -->
  <div class="tabs-container">
    <button class="tab-btn active" data-amenity="Basketball Court">
      <i class="fas fa-basketball-ball"></i> Basketball Court
    </button>
    <button class="tab-btn" data-amenity="Multi-Purpose Hall">
      <i class="fas fa-building"></i> Multi-Purpose Hall
    </button>
  </div>

  <!-- Single Column Form -->
  <div class="form-wrapper">
    <div class="form-card">
      <h2 class="form-card-title">Reservation Details</h2>
      
      <form id="reservationForm">
        <div class="form-group">
          <label>Selected Amenity <span class="required">*</span></label>
          <input type="text" id="selectedAmenity" readonly class="readonly-input">
        </div>

        <div class="form-group">
          <label>Reservation Date <span class="required">*</span></label>
          <input type="text" id="datePicker" placeholder="Click to select a date" readonly>
          <div class="calendar-legend-inline">
            <span class="legend-dot available"></span> Available
            <span class="legend-dot user-pending"></span> Your Pending
            <span class="legend-dot user-approved"></span> Your Approved
            <span class="legend-dot unavailable"></span> Unavailable
          </div>
          <small class="form-hint"><i class="fas fa-info-circle"></i> Click the date field to open calendar</small>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Start Time <span class="required">*</span></label>
            <select id="startTime" class="time-select" disabled>
              <option value="">Select date first</option>
            </select>
          </div>
          <div class="form-group">
            <label>End Time <span class="required">*</span></label>
            <select id="endTime" class="time-select" disabled>
              <option value="">Select start time first</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label>Purpose of Reservation <span class="required">*</span></label>
          <select id="purpose" required>
            <option value="">Select a purpose</option>
            <option value="Practice">Practice</option>
            <option value="Event">Event</option>
            <option value="Meeting">Meeting</option>
            <option value="Celebration">Celebration</option>
            <option value="Others">Others</option>
          </select>
        </div>

        <div class="form-group">
          <label>Additional Notes</label>
          <textarea id="notes" rows="3" placeholder="Any special requests or additional information..."></textarea>
        </div>

        <div class="terms-section">
          <h4>Terms and Reminders</h4>
          <ul>
            <li>Reservations are subject to approval by the HOA.</li>
            <li>Please follow village rules and regulations when using the facility.</li>
            <li>Any damages to the facility may result in penalties.</li>
            <li>Payment for the reservation must be made at the HOA Office.</li>
            <li>Maximum of <strong>2 reservations per day</strong> per homeowner.</li>
            <li>Bookings can only be made up to <strong>14 days</strong> in advance.</li>
          </ul>
        </div>

        <div class="checkbox-group">
          <input type="checkbox" id="agreeTerms" required>
          <label for="agreeTerms">I agree to the terms and conditions. <span class="required">*</span></label>
        </div>

        <button type="submit" class="submit-btn">Submit Reservation Request</button>
      </form>
    </div>
  </div>
</main>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-content">
    <div class="footer-section footer-logo-section">
      <a asp-controller="Home" asp-action="Index" class="footer-logo-link">
        <img src="@Url.Content("~/assets/LBAlogo.png")" alt="Bel-Air Village Logo" class="footer-logo">
      </a>
    </div>
    <div class="footer-section">
      <h3>Contact Us</h3>
      <ul class="footer-links">
        <li><i class="fas fa-map-marker-alt"></i> P3 B15 Alpine St. LBA4, Brgy. Don Jose, Sta. Rosa, Laguna 4026</li>
        <li><i class="fas fa-phone"></i> (+63) 09398588138</li>
        <li><i class="fas fa-phone"></i> 0495603050</li>
      </ul>
    </div>
    <div class="footer-section">
      <h3>Quick Links</h3>
      <ul class="footer-links">
        <li><a asp-controller="Home" asp-action="aboutLagunaBelAir">About Us</a></li>
        <li><a asp-controller="Home" asp-action="contacts">Contact Us</a></li>
        <li><a href="#">FAQs</a></li>
        <li><a href="#">Privacy Policy</a></li>
      </ul>
    </div>
    <div class="footer-section">
      <h3>Site Links</h3>
      <ul class="footer-links">
        <li><a asp-controller="Home" asp-action="announcement">Announcements</a></li>
        <li><a asp-controller="Home" asp-action="calendars">Community Calendar</a></li>
        <li><a asp-controller="Home" asp-action="formsDocuments">Forms &amp; Documents</a></li>
        <li><a asp-controller="Home" asp-action="reportConcerns">Report a Concern</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; <span id="current-year"></span> Laguna BelAir 4. All rights reserved.</p>
  </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
  // Pass logged-in username to JavaScript
  window.CURRENT_USER = '@(username ?? "")';
</script>
<script src="/js/page-coordinator.js"></script>
<script src="/js/reserve.js"></script>
<script>
  document.getElementById('current-year').textContent = new Date().getFullYear();
  
  document.querySelectorAll('.dropdown').forEach(dropdown => {
    const toggle = dropdown.querySelector('.dropdown-toggle');
    if (!toggle) return;
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = dropdown.classList.contains('dropdown-open');
      document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('dropdown-open'));
      if (!isOpen) dropdown.classList.add('dropdown-open');
    });
  });
  
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.dropdown').forEach(d => {
      if (!d.contains(e.target)) d.classList.remove('dropdown-open');
    });
  });
</script>
</body>
</html>