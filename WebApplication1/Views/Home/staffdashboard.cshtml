  <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:var(--green);margin-bottom:12px">Notification Preferences</div>
  <label style="display:flex;align-items:center;gap:10px;margin-bottom:10px;cursor:pointer"><input type="checkbox" id="set-notif-inc" checked style="accent-color:var(--green)"> <span style="font-size:13px">Notify on new incident reports</span></label>
  <label style="display:flex;align-items:center;gap:10px;margin-bottom:10px;cursor:pointer"><input type="checkbox" id="set-notif-verif" checked style="accent-color:var(--green)"> <span style="font-size:13px">Notify on pending verifications</span></label>
  <label style="display:flex;align-items:center;gap:10px;margin-bottom:10px;cursor:pointer"><input type="checkbox" id="set-notif-exc" checked style="accent-color:var(--green)"> <span style="font-size:13px">Alert on new exchange approvals</span></label>
  <label style="display:flex;align-items:center;gap:10px;cursor:pointer"><input type="checkbox" id="set-notif-digest" style="accent-color:var(--green)"> <span style="font-size:13px">Daily summary digest</span></label>
</div>
<div style="border-top:1px solid var(--gray-100);padding-top:16px;margin-top:12px">
  <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;color:var(--green);margin-bottom:12px">Appearance</div>
  <div class="form-group"><label>Color Theme</label>
    <select id="set-theme" onchange="applyTheme(this.value)">
      <option value="green">Forest Green (Default)</option>
      <option value="blue">Navy Blue</option>
      <option value="slate">Slate Gray</option>
    </select>
  </div>
  <div class="form-group"><label>Font Size</label>
    <select id="set-fontsize" onchange="applyFontSize(this.value)">
      <option value="13.5px">Normal (Default)</option>
      <option value="14.5px">Large</option>
      <option value="12.5px">Small</option>
    </select>
  </div>
  <div class="form-group"><label>Sidebar on Load</label>
    <select id="set-sidebar">
      <option value="expanded">Expanded (Default)</option>
      <option value="collapsed">Collapsed</option>
    </select>
  </div>
</div>
<div class="modal-actions"><button class="btn btn-outline" onclick="closeModal('settings')">Cancel</button><button class="btn btn-primary" onclick="saveSettings()"><i class="fas fa-save"></i> Save Settings</button></div>
</div></div>

<!-- NOTIFICATION PANEL -->
<div class="notif-modal-overlay" id="notif-modal-overlay"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script src="~/js/staff-dashboard.js?v=3"></script>
</body>
</html>