<main class="main" id="main-content">

<!-- ═══════ OVERVIEW ═══════ -->
<div class="page active" id="page-overview">
  <div class="stats-row">
    <div class="stat-card"><div class="stat-icon si-red"><i class="fas fa-exclamation-circle"></i></div><div class="stat-info"><div class="stat-val" id="stat-open-incidents">0</div><div class="stat-label">Open Incidents</div><div class="stat-sub sub-down"><i class="fas fa-clock"></i> Awaiting action</div></div></div>
    <div class="stat-card"><div class="stat-icon si-yellow"><i class="fas fa-user-clock"></i></div><div class="stat-info"><div class="stat-val" id="stat-pending-verif">3</div><div class="stat-label">Pending Verification</div><div class="stat-sub sub-warn"><i class="fas fa-clock"></i> Awaiting review</div></div></div>
    <div class="stat-card"><div class="stat-icon si-orange"><i class="fas fa-store"></i></div><div class="stat-info"><div class="stat-val" id="overview-pending-exchange">5</div><div class="stat-label">Exchange Approvals</div><div class="stat-sub sub-warn"><i class="fas fa-clock"></i> Pending review</div></div></div>
    <div class="stat-card"><div class="stat-icon si-green"><i class="fas fa-home"></i></div><div class="stat-info"><div class="stat-val">342</div><div class="stat-label">Verified Residents</div><div class="stat-sub sub-up"><i class="fas fa-arrow-up"></i> +4 this month</div></div></div>
  </div>
  <div class="grid-60-40">
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-exclamation-triangle"></i> Recent Incident Reports</h3><button class="see-all" onclick="showPage('incidents',null)">View All</button></div>
      <div class="scroll-y" id="overview-incidents-list"><div class="empty-state-inline"><i class="fas fa-inbox"></i><span>No incident reports yet</span></div></div>
    </div>
    <div class="flex-col gap-18">
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-history"></i> Recent Activity</h3></div>
        <div class="scroll-y" style="max-height:190px" id="activity-feed">
          <div class="activity-item"><div class="act-dot" style="background:var(--blue)"></div><div class="act-body"><p><strong>Jess T.</strong> approved post from <em>Pedro Cruz</em></p><div class="act-time">1 hr ago</div></div></div>
          <div class="activity-item"><div class="act-dot" style="background:var(--accent-dark)"></div><div class="act-body"><p><strong>Rodel L.</strong> verified resident <em>Sofia Mendez</em></p><div class="act-time">2 hr ago</div></div></div>
          <div class="activity-item"><div class="act-dot" style="background:var(--orange)"></div><div class="act-body"><p><strong>Carlo P.</strong> flagged post in <em>Usap Tayo</em></p><div class="act-time">3 hr ago</div></div></div>
        </div>
      </div>
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-calendar-alt"></i> Upcoming Events</h3><button class="see-all" onclick="showPage('events',null)">Manage</button></div>
        <div id="overview-events-mini">
          <div class="event-row"><div class="ev-badge"><div class="ev-day">19</div><div class="ev-mon">Feb</div></div><div class="ev-info"><div class="ev-title">BOD Gate Pass Policy Review</div><div class="ev-time"><i class="fas fa-clock"></i> 10:00 AM · Admin Office</div></div></div>
          <div class="event-row"><div class="ev-badge"><div class="ev-day">25</div><div class="ev-mon">Feb</div></div><div class="ev-info"><div class="ev-title">Community Clean-up Drive</div><div class="ev-time"><i class="fas fa-clock"></i> 7:00 AM · All Blocks</div></div></div>
        </div>
      </div>
    </div>
  </div>
  <div class="grid-3">
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-user-check"></i> Verification Queue</h3><button class="see-all" onclick="showPage('residents',null)">View All</button></div>
      <div class="verif-item"><div class="verif-av">SM</div><div class="verif-info"><div class="verif-name">Sofia Mendez</div><div class="verif-sub">Block A, H12 · Today</div></div><div class="verif-actions"><button class="approve-btn yes" onclick="quickApprove(this,'Sofia Mendez')"><i class="fas fa-check"></i></button><button class="approve-btn no" onclick="quickReject(this,'Sofia Mendez')"><i class="fas fa-times"></i></button><button class="approve-btn view-btn" onclick="openResidentDetail({name:'Sofia Mendez',unit:'Block A, H12',date:'Today',docs:[{name:'Government ID'},{name:'Proof of Residency'}]})"><i class="fas fa-eye"></i></button></div></div>
      <div class="verif-item"><div class="verif-av" style="background:linear-gradient(135deg,#1a5fa8,#4a90e2)">JR</div><div class="verif-info"><div class="verif-name">Joel Ramos</div><div class="verif-sub">Block C, H8 · Feb 17</div></div><div class="verif-actions"><button class="approve-btn yes" onclick="quickApprove(this,'Joel Ramos')"><i class="fas fa-check"></i></button><button class="approve-btn no" onclick="quickReject(this,'Joel Ramos')"><i class="fas fa-times"></i></button><button class="approve-btn view-btn" onclick="openResidentDetail({name:'Joel Ramos',unit:'Block C, H8',date:'Feb 17',docs:[{name:'Government ID'}]})"><i class="fas fa-eye"></i></button></div></div>
      <div class="verif-item"><div class="verif-av" style="background:linear-gradient(135deg,#c06418,#e8903a)">LP</div><div class="verif-info"><div class="verif-name">Liza Pascual</div><div class="verif-sub">Block B, H3 · Feb 16 ⚠️</div></div><div class="verif-actions"><button class="approve-btn yes" onclick="quickApprove(this,'Liza Pascual')"><i class="fas fa-check"></i></button><button class="approve-btn no" onclick="quickReject(this,'Liza Pascual')"><i class="fas fa-times"></i></button><button class="approve-btn view-btn" onclick="openResidentDetail({name:'Liza Pascual',unit:'Block B, H3',date:'Feb 16',docs:[{name:'Government ID'}],missing:'Proof of Residency'})"><i class="fas fa-eye"></i></button></div></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-store"></i> Pending Exchange Posts</h3><button class="see-all" onclick="showPage('exchange',null)">View All</button></div>
      <div id="overview-exchange-list"></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-bolt"></i> Quick Actions</h3></div>
      <div class="qa-grid">
        <div class="qa-item" onclick="openModal('addTask')"><div class="qa-emoji">📋</div><div class="qa-label">New Task</div><div class="qa-sub">Add to task board</div></div>
        <div class="qa-item" onclick="openModal('addAnnouncement')"><div class="qa-emoji">📢</div><div class="qa-label">Announcement</div><div class="qa-sub">Post to residents</div></div>
        <div class="qa-item" onclick="showPage('communitymap',null)"><div class="qa-emoji">🗺️</div><div class="qa-label">Community Map</div><div class="qa-sub">All map items</div></div>
        <div class="qa-item" onclick="showPage('documents',null)"><div class="qa-emoji">📁</div><div class="qa-label">Upload Doc</div><div class="qa-sub">Forms &amp; files</div></div>
        <div class="qa-item" onclick="openModal('addIncident')"><div class="qa-emoji">⚠️</div><div class="qa-label">Log Incident</div><div class="qa-sub">New report</div></div>
        <div class="qa-item" onclick="openModal('addEvent')"><div class="qa-emoji">📅</div><div class="qa-label">Add Event</div><div class="qa-sub">To calendar</div></div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════ INCIDENTS ═══════ -->
<div class="page" id="page-incidents">
  <div class="sec-header"><h2><i class="fas fa-exclamation-circle"></i> Incident Reports &amp; Monitoring</h2><button class="btn btn-primary" onclick="openModal('addIncident')"><i class="fas fa-plus"></i> Log Incident</button></div>
  <div style="display:grid;grid-template-columns:1.65fr 1fr;gap:18px;margin-bottom:20px">
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-map-marked-alt"></i> Incident Map</h3><button class="see-all" onclick="showPage('communitymap',null)">Full Map</button></div>
      <div id="cm-preview" style="height:420px"></div>
    </div>
    <div class="flex-col gap-16">
      <div class="card"><div class="card-header"><h3><i class="fas fa-chart-pie"></i> Priority Distribution</h3></div><div class="card-body">
        <div class="progress-wrap"><div class="progress-label"><span>High</span><span id="dist-high-n">0</span></div><div class="progress-bar"><div class="progress-fill pf-orange" id="dist-high-bar" style="width:0%"></div></div></div>
        <div class="progress-wrap"><div class="progress-label"><span>Medium</span><span id="dist-medium-n">0</span></div><div class="progress-bar"><div class="progress-fill pf-blue" id="dist-medium-bar" style="width:0%"></div></div></div>
        <div class="progress-wrap"><div class="progress-label"><span>Low</span><span id="dist-low-n">0</span></div><div class="progress-bar"><div class="progress-fill pf-green" id="dist-low-bar" style="width:0%"></div></div></div>
        <div id="dist-empty" style="color:var(--gray-400);font-size:12px;font-style:italic;text-align:center;padding:8px 0">No incidents logged yet</div>
      </div></div>
      <div class="card"><div class="card-header"><h3><i class="fas fa-tags"></i> Common Keywords</h3><span class="page-note">From reports</span></div>
        <div class="keyword-grid" id="common-keywords-grid"><div class="empty-state-inline" style="padding:16px"><i class="fas fa-tags"></i><span>Appear as incidents are logged</span></div></div>
      </div>
    </div>
  </div>
  <div class="info-banner" style="margin-bottom:18px">
    <i class="fas fa-info-circle"></i> <strong>Keyword Detection:</strong> Keywords are automatically extracted from incident descriptions using the Word Bank dictionary. Priority levels are auto-assigned based on detected keywords (high urgency = immediate action required).
  </div>
  <div class="card" id="incidents-table-card">
    <div class="card-header"><h3><i class="fas fa-list"></i> All Incident Reports</h3>
      <div class="chip-row">
        <div class="chip active" onclick="filterIncidents('all',this)">All</div>
        <div class="chip" onclick="filterIncidents('high',this)"><i class="fas fa-arrow-up" style="color:#c0392b"></i> High Priority</div>
        <div class="chip" onclick="filterIncidents('medium',this)"><i class="fas fa-circle" style="color:#f39c12"></i> Medium</div>
        <div class="chip" onclick="filterIncidents('low',this)"><i class="fas fa-arrow-down" style="color:#27ae60"></i> Low</div>
      </div>
    </div>
    <div class="tbl-wrap"><table><thead><tr><th>Ref #</th><th>Priority</th><th>Description</th><th>Location</th><th>Category</th><th>Reporter</th><th>Date</th><th>Keywords</th><th>Public</th><th>Action</th></tr></thead>
    <tbody id="incidents-tbody"><tr><td colspan="10" style="text-align:center;padding:32px;color:var(--gray-400)"><i class="fas fa-spinner fa-spin" style="font-size:18px;display:block;margin-bottom:8px"></i>Loading incidents...</td></tr></tbody></table></div>
  </div>
</div>

<!-- ═══════ TASK BOARD ═══════ -->
<div class="page" id="page-taskboard">
  <div class="sec-header"><h2><i class="fas fa-columns"></i> Task Board</h2><button class="btn btn-primary" onclick="openModal('addTask')"><i class="fas fa-plus"></i> Add Task</button></div>
  <div class="card">
    <div class="kanban-toolbar">
      <button class="btn btn-primary btn-sm" id="ktf-all" onclick="filterTasks('all',this)"><i class="fas fa-th"></i> All Tasks</button>
      <button class="btn btn-outline btn-sm" id="ktf-high" onclick="filterTasks('high',this)"><i class="fas fa-arrow-up"></i> High Priority</button>
      <div style="margin-left:auto;font-size:12px;color:var(--gray-400)">Drag cards between columns · Click ✕ to delete</div>
    </div>
    <div class="kanban-board" id="kanban-board">
      <div class="k-col" data-col="todo">
        <div class="k-col-head"><div class="k-col-dot" style="background:#9e9a94"></div><div class="k-col-title">To Do</div><div class="k-col-count" id="k-count-todo">4</div></div>
        <div class="k-col-body" id="k-body-todo">
          <div class="k-card kc-orange" draggable="true" data-task-id="t1" data-priority="high" data-due="2026-02-28"><div class="k-card-header-row"><span class="tag tag-orange">Admin</span><button class="k-card-del" onclick="deleteTask(this)"><i class="fas fa-times"></i></button></div><div class="k-card-title">Update emergency contact list for Phase 3</div><div class="k-card-meta"><div class="k-card-date overdue"><i class="fas fa-clock"></i> Feb 28</div><div class="mini-avs"><div class="mini-av ma-g">MS</div></div></div></div>
          <div class="k-card kc-orange" draggable="true" data-task-id="t2" data-priority="medium" data-due="2026-03-01"><div class="k-card-header-row"><span class="tag tag-orange">Admin</span><button class="k-card-del" onclick="deleteTask(this)"><i class="fas fa-times"></i></button></div><div class="k-card-title">Prepare March BOD meeting agenda</div><div class="k-card-meta"><div class="k-card-date"><i class="fas fa-calendar"></i> Mar 1</div><div class="mini-avs"><div class="mini-av ma-b">JT</div></div></div></div>
          <div class="k-card kc-yellow" draggable="true" data-task-id="t3" data-priority="medium" data-due="2026-03-05"><div class="k-card-header-row"><span class="tag tag-gray">Maintenance</span><button class="k-card-del" onclick="deleteTask(this)"><i class="fas fa-times"></i></button></div><div class="k-card-title">Schedule annual park equipment inspection</div><div class="k-card-meta"><div class="k-card-date"><i class="fas fa-calendar"></i> Mar 5</div><div class="mini-avs"><div class="mini-av ma-a">RL</div></div></div></div>
          <div class="k-card" draggable="true" data-task-id="t4" data-priority="low" data-due="2026-02-20"><div class="k-card-header-row"><span class="tag tag-blue">Communications</span><button class="k-card-del" onclick="deleteTask(this)"><i class="fas fa-times"></i></button></div><div class="k-card-title">Post February community newsletter</div><div class="k-card-meta"><div class="k-card-date"><i class="fas fa-calendar"></i> Feb 20</div><div class="mini-avs"><div class="mini-av ma-b">CP</div></div></div></div>
          <button class="k-add-btn" onclick="openModal('addTask')"><i class="fas fa-plus"></i> Add task</button>
        </div>
      </div>
      <div class="k-col" data-col="progress">
        <div class="k-col-head"><div class="k-col-dot" style="background:#1a5fa8"></div><div class="k-col-title">In Progress</div><div class="k-col-count" id="k-count-progress">2</div></div>
        <div class="k-col-body" id="k-body-progress">
          <div class="k-card kc-orange" draggable="true" data-task-id="t5" data-priority="high" data-due="2026-02-28"><div class="k-card-header-row"><span class="tag tag-orange">Finance</span><button class="k-card-del" onclick="deleteTask(this)"><i class="fas fa-times"></i></button></div><div class="k-card-title">Q1 dues follow-up — 18 households</div><div class="k-card-meta"><div class="k-card-date"><i class="fas fa-calendar"></i> Feb 28</div><div class="mini-avs"><div class="mini-av ma-b">JT</div></div></div></div>
          <div class="k-card kc-yellow" draggable="true" data-task-id="t6" data-priority="medium" data-due="2026-02-25"><div class="k-card-header-row"><span class="tag tag-gray">Maintenance</span><button class="k-card-del" onclick="deleteTask(this)"><i class="fas fa-times"></i></button></div><div class="k-card-title">Repaint perimeter fence — Block C</div><div class="k-card-meta"><div class="k-card-date"><i class="fas fa-calendar"></i> Feb 25</div><div class="mini-avs"><div class="mini-av ma-a">RL</div></div></div></div>
          <button class="k-add-btn" onclick="openModal('addTask')"><i class="fas fa-plus"></i> Add task</button>
        </div>
      </div>
      <div class="k-col" data-col="review">
        <div class="k-col-head"><div class="k-col-dot" style="background:#c06418"></div><div class="k-col-title">For Review</div><div class="k-col-count" id="k-count-review">2</div></div>
        <div class="k-col-body" id="k-body-review">
          <div class="k-card kc-orange" draggable="true" data-task-id="t7" data-priority="high" data-due="2026-02-19"><div class="k-card-header-row"><span class="tag tag-orange">Admin</span><button class="k-card-del" onclick="deleteTask(this)"><i class="fas fa-times"></i></button></div><div class="k-card-title">Gate pass policy revision — BOD approval</div><div class="k-card-meta"><div class="k-card-date"><i class="fas fa-calendar"></i> Feb 19</div><div class="mini-avs"><div class="mini-av ma-b">JT</div><div class="mini-av ma-g">MS</div></div></div></div>
          <div class="k-card kc-yellow" draggable="true" data-task-id="t8" data-priority="medium" data-due="2026-02-22"><div class="k-card-header-row"><span class="tag tag-green">Environment</span><button class="k-card-del" onclick="deleteTask(this)"><i class="fas fa-times"></i></button></div><div class="k-card-title">Main Blvd landscaping proposal — 3 quotes</div><div class="k-card-meta"><div class="k-card-date"><i class="fas fa-calendar"></i> Feb 22</div><div class="mini-avs"><div class="mini-av ma-g">MS</div></div></div></div>
          <button class="k-add-btn" onclick="openModal('addTask')"><i class="fas fa-plus"></i> Add task</button>
        </div>
      </div>
      <div class="k-col" data-col="done">
        <div class="k-col-head"><div class="k-col-dot" style="background:#2e7a50"></div><div class="k-col-title">Done</div><div class="k-col-count" id="k-count-done">3</div></div>
