<!-- TOPBAR -->
<div class="topbar" id="topbar">
  <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
  <div>
    <div class="topbar-title" id="topbar-title">Overview</div>
    <div class="topbar-breadcrumb"><i class="fas fa-home"></i> Dashboard <i class="fas fa-chevron-right"></i> <span id="breadcrumb-label">Overview</span></div>
  </div>
  <div class="topbar-right">
    <div class="icon-btn" onclick="openNotifModal()" title="Notifications" style="position:relative">
