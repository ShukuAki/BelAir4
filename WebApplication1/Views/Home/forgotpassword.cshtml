<!-- ========================================
FORGOT PASSWORD SECTION
======================================== -->
<section class="forgot-section">
  <!-- Decorative Leaves -->
  <div class="leaf-decoration leaf-left-1"><i class="fas fa-leaf"></i></div>
  <div class="leaf-decoration leaf-left-2"><i class="fas fa-leaf"></i></div>
  <div class="leaf-decoration leaf-left-3"><i class="fas fa-leaf"></i></div>
  <div class="leaf-decoration leaf-right-1"><i class="fas fa-leaf"></i></div>
  <div class="leaf-decoration leaf-right-2"><i class="fas fa-leaf"></i></div>
  <div class="leaf-decoration leaf-right-3"><i class="fas fa-leaf"></i></div>

  <div class="forgot-container">
    <div class="forgot-box">
      <!-- Step 1: Request Reset -->
      <div id="step1" class="step-content active">
        <div class="forgot-header">
          <i class="fas fa-key"></i>
          <h1>Forgot Password?</h1>
          <p>Enter your email address and we'll help you reset your password.</p>
        </div>

        <form id="requestForm" class="forgot-form">
          <div class="form-group">
            <label for="email">
              <i class="fas fa-envelope"></i>
              Email Address
            </label>
            <input type="email" id="resetEmail" name="email" placeholder="Enter your registered email" required>
          </div>

          <button type="submit" class="reset-btn">
            <i class="fas fa-paper-plane"></i>
            Send Reset Link
          </button>

          <div class="back-link">
            <a href="login.html">
              <i class="fas fa-arrow-left"></i> Back to Login
            </a>
          </div>
        </form>
      </div>

      <!-- Step 2: Reset Password Form -->
      <div id="step2" class="step-content">
        <div class="forgot-header">
          <i class="fas fa-lock"></i>
          <h1>Reset Password</h1>
          <p id="resetEmailDisplay"></p>
        </div>

        <form id="resetForm" class="forgot-form">
          <div class="form-group">
            <label for="newPassword">
              <i class="fas fa-lock"></i>
              New Password
            </label>
            <div class="password-input-wrapper">
              <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password" required>
              <button type="button" class="toggle-password" data-target="newPassword" aria-label="Toggle password visibility">
                <i class="fas fa-eye"></i>
              </button>
            </div>
            <p class="password-hint">Password must be at least 8 characters</p>
          </div>

          <div class="form-group">
            <label for="confirmPassword">
              <i class="fas fa-lock"></i>
              Confirm Password
            </label>
            <div class="password-input-wrapper">
              <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required>
              <button type="button" class="toggle-password" data-target="confirmPassword" aria-label="Toggle password visibility">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="reset-btn">
            <i class="fas fa-check-circle"></i>
            Reset Password
          </button>

          <div class="back-link">
            <a href="login.html">
              <i class="fas fa-arrow-left"></i> Back to Login
            </a>
          </div>
        </form>
      </div>

      <!-- Step 3: Success Message -->
      <div id="step3" class="step-content">
        <div class="forgot-header">
          <i class="fas fa-check-circle"></i>
          <h1>Password Reset Successful!</h1>
          <p>Your password has been changed successfully.</p>
        </div>

        <div class="success-actions">
          <a href="login.html" class="login-btn-link">
            <i class="fas fa-sign-in-alt"></i> Login Now
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

