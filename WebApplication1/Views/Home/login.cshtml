<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Bel-Air Village 4</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/login.css">
</head>
<body>
    <!-- ========================================
    HEADER SECTION
    ======================================== -->
    <div class="top-header-container">
        <!-- Logo Section -->
        <div class="logo-section">
                <a asp-controller="Home" asp-action="Index" class="logo-link">
                <img src="~/assets/LBAlogo.png" alt="Bel-Air Village Logo" class="logo-image">
            </a>
        </div>
        <!-- Navbar Wrapper -->
        <div class="header-center-wrapper">
            <div class="navbar-two-rows">
                <!-- Top Row: Utility Links -->
                <div class="navbar-top-row">
                    <a asp-controller="Home" asp-action="login"><i class="fas fa-sign-in-alt"></i> Login</a>
                    <span class="nav-separator">|</span>
                    <a asp-controller="Home" asp-action="register"><i class="fas fa-user-plus"></i> Register</a>
                </div>
                <!-- Bottom Row: Main Navigation -->
                <div class="navbar-bottom-row">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">About <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                            <a asp-controller="Home" asp-action="aboutlagunabelair">Laguna BelAir 4</a>
                            <a asp-controller="Home" asp-action="committeesBods">Committees/BODs</a>
                            <a asp-controller="Home" asp-action="landMarks">Landmarks</a>
                            <a asp-controller="Home" asp-action="contacts">Contacts</a>
                        </div>
                    </div>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">Community <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                            <a asp-controller="Home" asp-action="announcement">Announcements</a>
                            <a asp-controller="Home" asp-action="forums">Forums/Discussions</a>
                            <a asp-controller="Home" asp-action="advertisements">Advertisements</a>
                            <a asp-controller="Home" asp-action="calendars">Calendars</a>
                            <a asp-controller="Home" asp-action="meetingAgendas">Meeting Record/Governance</a>
                            <a asp-controller="Home" asp-action="communityMap">Community Map</a>
                        </div>
                    </div>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">Services <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                            <a asp-controller="Home" asp-action="reserve">Reserve Amenities</a>
                            <a asp-controller="Home" asp-action="reportConcerns">Report Concerns/Incidents</a>
                        </div>
                    </div>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">Others <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                            <a asp-controller="Home" asp-action="formsDocuments">Downloadable Forms and Documents</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================
     LOGIN SECTION
     ======================================== -->

    <section class="login-section">
        <div class="login-container">
            <div class="login-box">
                <div class="login-header">
                    <i class="fas fa-lock"></i>
                    <h1>Login</h1>
                    <p>Welcome back! Please login to your account.</p>
                </div>

                <!-- form posts explicitly to /login -->
                <form action="/login" method="post" class="login-form" id="loginForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group">
                        <label for="username">
                            <i class="fas fa-envelope"></i>
                            Email Address
                        </label>
                        <input type="email" id="username" name="username" class="form-control" placeholder="Enter your email" required />
                    </div>

                    <div class="form-group">
                        <label for="password">
                            <i class="fas fa-lock"></i>
                            Password
                        </label>
                        <div class="password-input-wrapper">
                            <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required />
                        </div>
                    </div>

                    <div class="form-options">
                        <label class="remember-me">
                            <input type="checkbox" name="remember" />
                            <span>Remember Me</span>
                        </label>
                        <a href="forgot-password.html" class="forgot-password">Forgot Password?</a>
                    </div>

                    <button type="submit" class="login-btn">
                        <i class="fas fa-sign-in-alt"></i>
                        Login
                    </button>

                    <div class="register-link">
                        <p>Not a Member? <a href="register.html">Register here</a></p>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- ========================================
    FOOTER SECTION
    ======================================== -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section footer-logo-section">
                <a asp-controller="Home" asp-action="index" class="footer-logo-link">
                    <img src="~/assets/LBAlogo.png" alt="Bel-Air Village Logo" class="footer-logo">
                </a>
            </div>
            <div class="footer-section">
                <h3>Contact Us</h3>
                <ul class="footer-links">
                    <li><i class="fas fa-map-marker-alt"></i> P3 B15 Alpine St. LBA4, Brgy. Don Jose, Sta. Rosa, Laguna 4026</li>
                    <li><i class="fas fa-phone"></i> (+63) 09398588138</li>
                    <li><i class="fas fa-phone"></i> 0495603050</li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Quick Links</h3>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="aboutlagunabelair">About Us</a></li>
                    <li><a asp-controller="Home" asp-action="contacts">Contact Us</a></li>
                    <li><a asp-controller="Home" asp-action="faq">FAQs</a></li>
                    <li><a asp-controller="Home" asp-action="privacyPolicy">Privacy Policy</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Site Links</h3>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="announcements">Announcements</a></li>
                    <li><a asp-controller="Home" asp-action="communityCalendar">Community Calendar</a></li>
                    <li><a asp-controller="Home" asp-action="formsDocuments">Forms & Documents</a></li>
                    <li><a asp-controller="Home" asp-action="reportConcerns">Report a Concern</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; <span id="current-year">2026</span> Laguna BelAir 4. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>