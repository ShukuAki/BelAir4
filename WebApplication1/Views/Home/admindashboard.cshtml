          <div class="toggle-row"><div class="toggle-label"><strong>Maintenance Mode</strong><div class="toggle-desc">Show maintenance page to residents (staff can still access)</div></div><label class="toggle-switch"><input type="checkbox" id="setting-maintenance-mode"><span class="toggle-slider"></span></label></div>
          <div class="toggle-row"><div class="toggle-label"><strong>Two-Factor Auth Required</strong><div class="toggle-desc">Require 2FA for all staff logins</div></div><label class="toggle-switch"><input type="checkbox" id="setting-2fa-required" checked><span class="toggle-slider"></span></label></div>
        </div>
      </div>
    </div>
  </div>

  <!-- WORD BANK CONFIG -->
  <div class="page" id="page-wordbank">
    <div class="sec-header"><h2><i class="fas fa-brain"></i> Word Bank Configuration</h2>
      <button class="btn btn-primary" onclick="openModal('addKeyword')"><i class="fas fa-plus"></i> Add Keyword</button>
    </div>
    <div class="info-banner"><i class="fas fa-info-circle"></i> <strong>Admin Access:</strong> Add, edit, or delete keywords that drive automatic incident priority detection. Changes take effect immediately across the platform.</div>
