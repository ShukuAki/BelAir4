          <button class="btn btn-outline btn-sm" onclick="testNotification()"><i class="fas fa-paper-plane"></i> Send Test</button>
        </div>
      </div>
    </div>
  </div>

  <!-- DATA EXPORT -->
  <div class="page" id="page-dataexport">
    <div class="sec-header"><h2><i class="fas fa-file-export"></i> Data Export</h2></div>
    <div class="info-banner"><i class="fas fa-lock"></i> <strong>Admin Only.</strong> All exports are logged in the audit trail with your account name, timestamp, and IP address.</div>
    <div class="grid-2">
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-database"></i> Export Datasets</h3></div>
        <div class="export-row">
          <div class="export-icon"><i class="fas fa-users"></i></div>
          <div class="export-body"><div class="export-title">Resident Directory</div><div class="export-desc">All verified residents with contact info, block, unit, verification dates</div></div>
          <div class="export-actions">
            <button class="btn btn-outline btn-sm export-btn" data-dataset="Resident Directory" data-format="CSV"><i class="fas fa-file-csv"></i> CSV</button>
            <button class="btn btn-outline btn-sm export-btn" data-dataset="Resident Directory" data-format="XLSX"><i class="fas fa-file-excel"></i> XLSX</button>
          </div>
        </div>
        <div class="export-row">
          <div class="export-icon"><i class="fas fa-exclamation-circle"></i></div>
          <div class="export-body"><div class="export-title">Incident Reports</div><div class="export-desc">All incidents with priority, status, location, reporter, dates</div></div>
          <div class="export-actions">
            <button class="btn btn-outline btn-sm export-btn" data-dataset="Incident Reports" data-format="CSV"><i class="fas fa-file-csv"></i> CSV</button>
            <button class="btn btn-outline btn-sm export-btn" data-dataset="Incident Reports" data-format="PDF"><i class="fas fa-file-pdf"></i> PDF</button>
          </div>
        </div>
        <div class="export-row">
          <div class="export-icon"><i class="fas fa-history"></i></div>
          <div class="export-body"><div class="export-title">Audit Log</div><div class="export-desc">All system actions, user activity, IP addresses, timestamps</div></div>
          <div class="export-actions">
            <button class="btn btn-outline btn-sm export-btn" data-dataset="Audit Log" data-format="CSV"><i class="fas fa-file-csv"></i> CSV</button>
            <button class="btn btn-primary btn-sm export-btn" data-dataset="Audit Log" data-format="ALL"><i class="fas fa-download"></i> Export All</button>
          </div>
        </div>
        <div class="export-row">
          <div class="export-icon"><i class="fas fa-users-cog"></i></div>
          <div class="export-body"><div class="export-title">Staff Activity</div><div class="export-desc">Login history, actions performed, response times by staff member</div></div>
          <div class="export-actions">
            <button class="btn btn-outline btn-sm export-btn" data-dataset="Staff Activity" data-format="CSV"><i class="fas fa-file-csv"></i> CSV</button>
            <button class="btn btn-outline btn-sm export-btn" data-dataset="Staff Activity" data-format="XLSX"><i class="fas fa-file-excel"></i> XLSX</button>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-clock"></i> Recent Exports</h3><span class="export-live-badge"><i class="fas fa-circle" style="color:var(--green);font-size:8px"></i> Live</span></div>
        <div class="tbl-wrap"><table><thead><tr><th>File</th><th>Exported By</th><th>Date</th><th>Size</th></tr></thead><tbody id="recent-exports-tbody">
          <tr><td colspan="4" style="text-align:center;padding:24px;color:var(--gray-400)">No exports yet this session.</td></tr>
        </tbody></table></div>
      </div>
    </div>
  </div>

  <!-- BACKUPS -->
  <div class="page" id="page-backups">
    <div class="sec-header"><h2><i class="fas fa-database"></i> Backup Management</h2>
      <button class="btn btn-primary" id="mainBackupBtn"><i class="fas fa-play"></i> Run Manual Backup</button>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-list"></i> Backup History (Last 10)</h3></div>
      <div class="tbl-wrap"><table><thead><tr><th>Backup ID</th><th>Date & Time</th><th>Type</th><th>Size</th><th>Status</th><th>Actions</th></tr></thead><tbody id="backup-tbody">
        <tr><td colspan="6" style="text-align:center;padding:24px"><i class="fas fa-spinner fa-spin"></i> Loading backups...</td></tr>
      </tbody></table></div>
    </div>
  </div>

</main>

