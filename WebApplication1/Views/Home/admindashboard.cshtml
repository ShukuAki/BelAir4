      <div class="card-header"><h3><i class="fas fa-list"></i> Keyword Registry</h3>
        <div class="chip-row" id="wb-chips">
          <div class="chip active" onclick="filterKeywords('all',this)">All</div>
          <div class="chip" onclick="filterKeywords('high',this)">High</div>
          <div class="chip" onclick="filterKeywords('medium',this)">Medium</div>
          <div class="chip" onclick="filterKeywords('low',this)">Low</div>
        </div>
      </div>
      <div class="tbl-wrap"><table><thead><tr><th>Keyword</th><th>Description</th><th>Severity</th><th>Category</th><th>Language</th><th>Last Updated</th><th>Actions</th></tr></thead><tbody id="wordbank-tbody">
        <tr><td colspan="7" style="text-align:center;padding:24px"><i class="fas fa-spinner fa-spin"></i> Loading keywords...</td></tr>
      </tbody></table></div>
    </div>
  </div>

  <!-- INTEGRATIONS -->
  <div class="page" id="page-integrations">
    <div class="sec-header"><h2><i class="fas fa-plug"></i> Third-Party Integrations</h2></div>
    <div class="info-banner"><i class="fas fa-info-circle"></i> Manage external services connected to the platform.</div>
    <div class="grid-2">
      <div class="integration-card int-active">
        <div class="int-logo"><i class="fas fa-bell" style="color:var(--gold)"></i></div>
        <div class="int-body">
          <div class="int-name">Subscribe Notification (Push Alerts)</div>
          <div class="int-desc">Residents can subscribe to receive push notifications for announcements, incidents, and HOA alerts directly to their devices.</div>
          <div class="int-meta"><span class="status-pill sp-approved">Connected</span> · <span id="int-active-count">0</span> active subscribers</div>
          <div class="int-stats" style="margin-top:10px;display:flex;gap:16px;flex-wrap:wrap">
            <div style="font-size:11.5px;color:var(--gray-600)"><strong style="font-size:15px;color:var(--navy)" id="int-subscriber-count">0</strong><br>Subscribers</div>
            <div style="font-size:11.5px;color:var(--gray-600)"><strong style="font-size:15px;color:var(--navy)" id="int-sent-count">0</strong><br>Notifications sent</div>
          </div>
        </div>
        <div class="int-actions" style="display:flex;flex-direction:column;gap:8px">
