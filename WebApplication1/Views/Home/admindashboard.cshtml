<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Panel — Laguna BelAir 4</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/admin-dashboard.css">
</head>
<body>

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
  <div class="sb-brand">
    <div class="sb-logo-wrap"><i class="fas fa-shield-alt"></i></div>
    <div class="sb-brand-text">
      <span class="site-name">Laguna BelAir 4</span>
      <span class="site-sub">Admin Control Panel</span>
    </div>
  </div>
  <div class="sb-user">
    <div class="sb-avatar admin-av">A</div>
    <div class="sb-user-info">
      <div class="u-name">System Administrator</div>
      <div class="u-role"><i class="fas fa-crown"></i> Admin</div>
    </div>
    <div class="online-dot"></div>
  </div>
  <nav class="sb-nav">
    <div class="nav-group-label">Overview</div>
    <div class="nav-link active" onclick="showPage('overview',this)"><i class="fas fa-tachometer-alt"></i> Admin Overview</div>
    <div class="nav-link" onclick="showPage('auditlog',this)"><i class="fas fa-history"></i> Audit Log<span class="nav-badge">New</span></div>

    <div class="nav-group-label">User Management</div>
    <div class="nav-link" onclick="showPage('staffaccounts',this)"><i class="fas fa-user-cog"></i> Staff Accounts<span class="nav-badge yellow">1</span></div>
    <div class="nav-link" onclick="showPage('roles',this)"><i class="fas fa-key"></i> Roles & Permissions</div>
    <div class="nav-link" onclick="showPage('allresidents',this)"><i class="fas fa-users"></i> Residents & Banned<span class="nav-badge">2</span></div>

    <div class="nav-group-label">System Configuration</div>
    <div class="nav-link" onclick="showPage('appsettings',this)"><i class="fas fa-sliders-h"></i> App Settings</div>
    <div class="nav-link" onclick="showPage('wordbank',this)"><i class="fas fa-brain"></i> Word Bank Config</div>
    <div class="nav-link" onclick="showPage('integrations',this)"><i class="fas fa-plug"></i> Integrations</div>

    <div class="nav-group-label">Data</div>
    <div class="nav-link" onclick="showPage('dataexport',this)"><i class="fas fa-file-export"></i> Data Export</div>
    <div class="nav-link" onclick="showPage('backups',this)"><i class="fas fa-database"></i> Backups</div>

    <div class="nav-group-label">Navigate</div>
    <div class="nav-link staff-switch-link" onclick="window.location.href='staff-dashboard.html'">
      <i class="fas fa-arrow-left"></i> Staff Dashboard
      <span class="nav-badge" style="background:var(--accent);color:var(--navy-dark);animation:none">↗</span>
    </div>
  </nav>
  <div class="sb-footer" onclick="window.location.href='index.html'">
    <i class="fas fa-sign-out-alt"></i> Sign Out
  </div>
</aside>

<!-- TOPBAR -->
<div class="topbar">
  <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
  <div>
    <div class="topbar-title" id="topbar-title">Admin Overview</div>
    <div class="topbar-breadcrumb">
      <i class="fas fa-shield-alt"></i> Admin Panel <i class="fas fa-chevron-right"></i>
      <span id="breadcrumb-label">Overview</span>
    </div>
  </div>
  <div class="topbar-right">
    <div class="role-badge admin-role-badge"><i class="fas fa-crown"></i> Admin</div>

    <!-- Notification Bell with Dropdown -->
    <div class="notif-wrap" id="notifWrap">
      <button class="icon-btn notif-btn" id="notifBtn" title="System Alerts" onclick="toggleNotifDropdown()">
        <i class="fas fa-bell"></i>
        <div class="notif-dot" id="notifDot"></div>
      </button>
      <div class="notif-dropdown" id="notifDropdown">
        <div class="notif-dropdown-head">
          <span><i class="fas fa-exclamation-triangle"></i> System Alerts</span>
          <button class="notif-dismiss-all" onclick="dismissAllAlerts()">Dismiss All</button>
        </div>
        <div class="notif-dropdown-body" id="notifDropdownBody">
          <div class="notif-item notif-critical" id="alert-storage">
            <div class="notif-item-icon"><i class="fas fa-database"></i></div>
            <div class="notif-item-body">
              <div class="notif-item-title">Database storage at 78% capacity</div>
              <div class="notif-item-meta">Estimated full in 14 days · Auto-backup enabled</div>
            </div>
            <button class="notif-item-dismiss" onclick="dismissAlert('alert-storage',event)"><i class="fas fa-times"></i></button>
          </div>
          <div class="notif-item notif-warn" id="alert-login">
            <div class="notif-item-icon"><i class="fas fa-user-times"></i></div>
            <div class="notif-item-body">
              <div class="notif-item-title">Login anomaly — Rodel L.</div>
              <div class="notif-item-meta">5 failed login attempts · Feb 18, 2:14 AM</div>
            </div>
            <button class="notif-item-dismiss" onclick="dismissAlert('alert-login',event)"><i class="fas fa-times"></i></button>
          </div>
          <div class="notif-item notif-info" id="alert-notif">
            <div class="notif-item-icon"><i class="fas fa-bell"></i></div>
            <div class="notif-item-body">
              <div class="notif-item-title">Push notification service expiring in 7 days</div>
              <div class="notif-item-meta">Renewal required by Mar 1</div>
            </div>
            <button class="notif-item-dismiss" onclick="dismissAlert('alert-notif',event)"><i class="fas fa-times"></i></button>
          </div>
        </div>
        <div class="notif-dropdown-foot">
          <button onclick="showPage('auditlog',document.querySelector('[onclick*=auditlog]'));closeNotifDropdown()">
            <i class="fas fa-history"></i> View Audit Log
          </button>
        </div>
      </div>
    </div>
    <!-- End Notification -->

  </div>
</div>

<!-- MAIN -->
<main class="main" id="main-content">

  <!-- ADMIN OVERVIEW -->
  <div class="page active" id="page-overview">
    <div class="admin-alert-bar">
      <i class="fas fa-crown"></i>
      <strong>Admin Control Panel</strong> — You have elevated system access. All actions are logged in the audit trail.
    </div>
    <div class="stats-row">
      <div class="stat-card"><div class="stat-icon si-navy"><i class="fas fa-users-cog"></i></div><div class="stat-info"><div class="stat-val" id="stat-staff-count">5</div><div class="stat-label">Active Staff Accounts</div><div class="stat-sub sub-up"><i class="fas fa-user-plus"></i> 1 pending invite</div></div></div>
      <div class="stat-card"><div class="stat-icon si-red"><i class="fas fa-exclamation-triangle"></i></div><div class="stat-info"><div class="stat-val" id="overview-alert-count">3</div><div class="stat-label">System Alerts</div><div class="stat-sub sub-down"><i class="fas fa-clock"></i> Requires attention</div></div></div>
      <div class="stat-card"><div class="stat-icon si-gold"><i class="fas fa-users"></i></div><div class="stat-info"><div class="stat-val" id="stat-total-residents">347</div><div class="stat-label">Total Residents</div><div class="stat-sub sub-up"><i class="fas fa-check"></i> 342 verified</div></div></div>
      <div class="stat-card"><div class="stat-icon si-green"><i class="fas fa-plug"></i></div><div class="stat-info"><div class="stat-val">1/1</div><div class="stat-label">Integration Active</div><div class="stat-sub sub-up"><i class="fas fa-check-circle"></i> Push Notifications</div></div></div>
    </div>
    <div class="grid-60-40">
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-exclamation-triangle"></i> System Alerts & Flags</h3></div>
        <div id="overview-alerts-list">
        <div class="alert-item alert-critical">
          <div class="alert-icon"><i class="fas fa-database"></i></div>
          <div class="alert-body"><div class="alert-title">Loading system alerts...</div></div>
        </div>
        </div>
      </div>
      <div class="flex-col gap-16">
        <div class="card">
          <div class="card-header"><h3><i class="fas fa-chart-line"></i> Platform Metrics (This Month)</h3></div>
          <div class="card-body" id="overview-metrics-body">
            <div class="metric-row"><div class="metric-label">Loading metrics...</div></div>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><h3><i class="fas fa-clock"></i> Recent Admin Actions</h3><button class="see-all" onclick="showPage('auditlog',document.querySelector('[onclick*=auditlog]'))">Full Log</button></div>
          <div class="scroll-y" style="max-height:160px" id="overview-recent-actions">
            <div class="activity-item"><div class="act-dot" style="background:var(--gray-300)"></div><div class="act-body"><p style="color:var(--gray-400);font-size:12px">Loading recent actions...</p></div></div>
          </div>
        </div>
      </div>
    </div>
    <div class="grid-2">
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-users-cog"></i> Staff Accounts</h3><button class="see-all" onclick="showPage('staffaccounts',document.querySelector('[onclick*=staffaccounts]'))">Manage</button></div>
        <div id="overview-staff-mini-list">
          <div class="staff-mini-item"><div class="staff-info"><div class="staff-name" style="color:var(--gray-400)">Loading staff...</div></div></div>
        </div>
      </div>
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-bolt"></i> Admin Quick Actions</h3></div>
        <div class="qa-grid">
          <div class="qa-item" onclick="openModal('inviteStaff')"><div class="qa-emoji">👤</div><div class="qa-label">Invite Staff</div><div class="qa-sub">New account</div></div>
          <div class="qa-item" onclick="showPage('dataexport',document.querySelector('[onclick*=dataexport]'))"><div class="qa-emoji">📤</div><div class="qa-label">Export Data</div><div class="qa-sub">CSV / Excel</div></div>
          <div class="qa-item" onclick="showPage('backups',document.querySelector('[onclick*=backups]'))"><div class="qa-emoji">💾</div><div class="qa-label">Backup Now</div><div class="qa-sub">Manual backup</div></div>
          <div class="qa-item" onclick="showPage('roles',document.querySelector('[onclick*=roles]'))"><div class="qa-emoji">🔑</div><div class="qa-label">Permissions</div><div class="qa-sub">Role config</div></div>
          <div class="qa-item" onclick="showPage('auditlog',document.querySelector('[onclick*=auditlog]'))"><div class="qa-emoji">📋</div><div class="qa-label">Audit Log</div><div class="qa-sub">Full history</div></div>
          <div class="qa-item" onclick="showPage('appsettings',document.querySelector('[onclick*=appsettings]'))"><div class="qa-emoji">⚙️</div><div class="qa-label">App Config</div><div class="qa-sub">System settings</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- AUDIT LOG -->
  <div class="page" id="page-auditlog">
    <div class="sec-header"><h2><i class="fas fa-history"></i> Audit Log</h2>
      <div style="display:flex;gap:8px">
        <button class="btn btn-outline btn-sm"><i class="fas fa-filter"></i> Filter</button>
        <button class="btn btn-primary btn-sm" id="exportLogBtn"><i class="fas fa-download"></i> Export Log</button>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-list"></i> All System Actions</h3>
        <div class="chip-row">
          <div class="chip active">All</div><div class="chip">Auth</div><div class="chip">Data Changes</div><div class="chip">Approvals</div><div class="chip">System</div>
        </div>
      </div>
      <div class="tbl-wrap"><table><thead><tr><th>Timestamp</th><th>User</th><th>Role</th><th>Action</th><th>Target</th><th>IP Address</th><th>Outcome</th></tr></thead><tbody id="audit-tbody">
        <tr><td class="mono">2026-02-18 09:14:22</td><td><strong>Admin</strong></td><td><span class="tag tag-navy">Admin</span></td><td>Updated permissions</td><td>Staff Role</td><td class="mono">192.168.1.1</td><td><span class="status-pill sp-approved">Success</span></td></tr>
        <tr><td class="mono">2026-02-18 09:00:01</td><td><strong>Admin</strong></td><td><span class="tag tag-navy">Admin</span></td><td>Exported resident CSV</td><td>residents_feb2026.csv</td><td class="mono">192.168.1.1</td><td><span class="status-pill sp-approved">Success</span></td></tr>
        <tr><td class="mono">2026-02-18 08:12:05</td><td><strong>Maria Santos</strong></td><td><span class="tag tag-blue">Staff</span></td><td>Escalated incident</td><td>#INC-087 → Critical</td><td class="mono">192.168.1.22</td><td><span class="status-pill sp-approved">Success</span></td></tr>
        <tr><td class="mono">2026-02-18 02:14:33</td><td><strong>Rodel Lim</strong></td><td><span class="tag tag-blue">Staff</span></td><td>Failed login (x5)</td><td>Auth endpoint</td><td class="mono">192.168.1.34</td><td><span class="status-pill sp-open">Blocked</span></td></tr>
        <tr><td class="mono">2026-02-17 16:45:12</td><td><strong>Jess Torres</strong></td><td><span class="tag tag-blue">Staff</span></td><td>Approved advertisement</td><td>Pedro Cruz — Lunch Boxes</td><td class="mono">192.168.1.15</td><td><span class="status-pill sp-approved">Success</span></td></tr>
        <tr><td class="mono">2026-02-17 14:30:08</td><td><strong>Maria Santos</strong></td><td><span class="tag tag-blue">Staff</span></td><td>Verified resident</td><td>Sofia Mendez — Block A</td><td class="mono">192.168.1.22</td><td><span class="status-pill sp-approved">Success</span></td></tr>
        <tr><td class="mono">2026-02-17 11:20:44</td><td><strong>Admin</strong></td><td><span class="tag tag-navy">Admin</span></td><td>Banned user account</td><td>TestAccount01</td><td class="mono">192.168.1.1</td><td><span class="status-pill sp-approved">Success</span></td></tr>
        <tr><td class="mono">2026-02-15 09:05:19</td><td><strong>Carlo Padilla</strong></td><td><span class="tag tag-blue">Staff</span></td><td>Removed forum post</td><td>Post #FRM-234 (Spam)</td><td class="mono">192.168.1.30</td><td><span class="status-pill sp-approved">Success</span></td></tr>
      </tbody></table></div>
    </div>
  </div>

  <!-- STAFF ACCOUNTS -->
  <div class="page" id="page-staffaccounts">
    <div class="sec-header"><h2><i class="fas fa-users-cog"></i> Staff Account Management</h2>
      <button class="btn btn-primary" onclick="openModal('inviteStaff')"><i class="fas fa-user-plus"></i> Invite Staff</button>
    </div>
    <div class="card" style="margin-bottom:18px">
      <div class="card-header"><h3><i class="fas fa-user-clock"></i> Pending Invitations <span id="pending-invites-count">(0)</span></h3></div>
      <div class="tbl-wrap"><table><thead><tr><th>Email</th><th>Role</th><th>Invited By</th><th>Date Sent</th><th>Expires</th><th>Actions</th></tr></thead><tbody id="pending-invites-tbody">
        <tr><td colspan="6" style="text-align:center;padding:24px"><i class="fas fa-spinner fa-spin"></i> Loading invitations...</td></tr>
      </tbody></table></div>
    </div>
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-users"></i> Active Staff</h3></div>
      <div class="tbl-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Last Login</th><th>Status</th><th>Actions</th></tr></thead><tbody id="staff-tbody">
        <tr><td colspan="6" style="text-align:center;padding:24px"><i class="fas fa-spinner fa-spin"></i> Loading staff accounts...</td></tr>
      </tbody></table></div>
    </div>
  </div>

  <!-- ROLES & PERMISSIONS -->
  <div class="page" id="page-roles">
    <div class="sec-header">
      <h2><i class="fas fa-key"></i> Roles & Permissions</h2>
      <button class="btn btn-primary" onclick="openModal('addRole')"><i class="fas fa-plus"></i> Add Role</button>
    </div>
    <div class="info-banner" style="background:#f0e8ff;border-color:#7c3aed;color:#4c1d95">
      <i class="fas fa-lock"></i> <strong>Admin</strong> always has full access and cannot be edited. Create custom roles and configure exactly what each one can see and do.
    </div>
    <div class="roles-layout">
      <div class="card roles-list-card">
        <div class="card-header"><h3><i class="fas fa-shield-alt"></i> All Roles</h3></div>
        <div id="roles-list">
          <div style="text-align:center;padding:24px;color:var(--gray-400)"><i class="fas fa-spinner fa-spin"></i> Loading roles...</div>
        </div>
      </div>
      <div class="card roles-editor-card">
        <div class="card-header">
          <h3><i class="fas fa-sliders-h"></i> Permissions — <span id="perm-role-name">Admin</span></h3>
          <div id="perm-editor-actions" style="display:none;gap:6px">
            <button class="btn btn-outline btn-sm" onclick="AdminDashboard.setAllPerms('full')">All Full</button>
            <button class="btn btn-outline btn-sm" onclick="AdminDashboard.setAllPerms('none')">Clear All</button>
            <button class="btn btn-primary btn-sm" onclick="AdminDashboard.savePermissions()"><i class="fas fa-save"></i> Save</button>
          </div>
          <div id="perm-admin-notice" style="font-size:11.5px;color:var(--gray-400);font-style:italic">Read-only — Admin always has full access</div>
        </div>
        <div class="perm-editor-body" id="perm-editor-body"></div>
        <div class="perm-legend">
          <span class="perm-legend-item"><span class="perm-pill perm-pill-full">Full</span> Create, edit, delete</span>
          <span class="perm-legend-item"><span class="perm-pill perm-pill-view">View</span> Read only</span>
          <span class="perm-legend-item"><span class="perm-pill perm-pill-none">None</span> No access</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ALL RESIDENTS + BANNED (COMBINED) -->
  <div class="page" id="page-allresidents">
    <div class="sec-header"><h2><i class="fas fa-users"></i> Residents & Banned — Admin View</h2>
      <div style="display:flex;gap:8px">
        <button class="btn btn-outline btn-sm" onclick="exportResidents()"><i class="fas fa-download"></i> Export</button>
        <button class="btn btn-primary" onclick="openModal('addResident')"><i class="fas fa-plus"></i> Add Resident</button>
      </div>
    </div>
    <div class="stats-row" style="grid-template-columns:repeat(4,1fr)">
      <div class="stat-card"><div class="stat-icon si-green"><i class="fas fa-user-check"></i></div><div class="stat-info"><div class="stat-val" id="stat-verified">342</div><div class="stat-label">Verified</div></div></div>
      <div class="stat-card"><div class="stat-icon si-yellow"><i class="fas fa-user-clock"></i></div><div class="stat-info"><div class="stat-val" id="stat-pending">3</div><div class="stat-label">Pending</div></div></div>
      <div class="stat-card"><div class="stat-icon si-red"><i class="fas fa-ban"></i></div><div class="stat-info"><div class="stat-val" id="stat-banned-count">2</div><div class="stat-label">Banned</div></div></div>
      <div class="stat-card"><div class="stat-icon si-navy"><i class="fas fa-home"></i></div><div class="stat-info"><div class="stat-val">180</div><div class="stat-label">Total Units</div></div></div>
    </div>

    <!-- Resident Directory -->
    <div class="card" style="margin-bottom:18px">
      <div class="card-header"><h3><i class="fas fa-list"></i> Resident Directory</h3>
        <div class="chip-row" id="resident-chips">
          <div class="chip active" onclick="filterResidents('all',this)">All</div>
          <div class="chip" onclick="filterResidents('Verified',this)">Verified</div>
          <div class="chip" onclick="filterResidents('Pending',this)">Pending</div>
          <div class="chip" onclick="filterResidents('Banned',this)">Banned</div>
        </div>
      </div>
      <div class="tbl-wrap"><table><thead><tr><th>Name</th><th>Unit</th><th>Block</th><th>Contact</th><th>Email</th><th>Verified</th><th>Status</th><th>Actions</th></tr></thead><tbody id="residents-tbody">
        <tr><td colspan="8" style="text-align:center;padding:24px"><i class="fas fa-spinner fa-spin"></i> Loading residents...</td></tr>
      </tbody></table></div>
    </div>

    <!-- Banned Users Detail Panel -->
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-ban"></i> Banned Users Detail</h3>
        <span id="banned-count-label" style="font-size:12px;color:var(--gray-400);font-weight:700">0 currently banned</span>
      </div>
      <div class="tbl-wrap"><table><thead><tr><th>Name / Account</th><th>Reason</th><th>Banned By</th><th>Date</th><th>Duration</th><th>Actions</th></tr></thead><tbody id="banned-tbody">
        <tr><td colspan="6" style="text-align:center;padding:24px"><i class="fas fa-spinner fa-spin"></i> Loading banned users...</td></tr>
      </tbody></table></div>
    </div>
  </div>

  <!-- APP SETTINGS -->
  <div class="page" id="page-appsettings">
    <div class="sec-header"><h2><i class="fas fa-sliders-h"></i> Application Settings</h2>
      <button class="btn btn-primary" id="saveSettingsBtn"><i class="fas fa-save"></i> Save Changes</button>
    </div>
    <div class="info-banner"><i class="fas fa-info-circle"></i> <strong>What does this do?</strong> App Settings controls the core configuration of the Laguna BelAir 4 HOA platform — village info, resident fees, which features are active for residents, and security policies for staff logins. Changes here affect all residents and staff immediately.</div>
    <div class="grid-2">
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-cog"></i> General Settings</h3></div>
        <div class="card-body">
          <div class="form-group"><label>Village Name</label><input type="text" value="Laguna BelAir 4" id="setting-village-name"></div>
          <div class="form-group"><label>HOA Email</label><input type="email" value="lba4hoa@email.com" id="setting-hoa-email"></div>
          <div class="form-group"><label>HOA Phone</label><input type="tel" value="0495603050" id="setting-hoa-phone"></div>
          <div class="form-group"><label>Ad Listing Fee (₱)</label><input type="number" value="150" id="setting-ad-fee"></div>
          <div class="form-group"><label>Monthly Dues Rate (₱)</label><input type="number" value="200" id="setting-dues-rate"></div>
          <div class="form-group"><label>Resident Verification Mode</label>
            <select id="setting-verification-mode">
              <option>Manual Review (Default)</option>
              <option>Auto-approve (not recommended)</option>
              <option>Admin-only approval</option>
            </select>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card-header"><h3><i class="fas fa-toggle-on"></i> Feature Toggles</h3></div>
        <div class="card-body">
          <div class="toggle-row"><div class="toggle-label"><strong>Forum Enabled</strong><div class="toggle-desc">Residents can post & comment in the community forum</div></div><label class="toggle-switch"><input type="checkbox" id="setting-forum-enabled" checked><span class="toggle-slider"></span></label></div>
          <div class="toggle-row"><div class="toggle-label"><strong>Marketplace / Ads</strong><div class="toggle-desc">Residents can list products & services for sale</div></div><label class="toggle-switch"><input type="checkbox" id="setting-marketplace-enabled" checked><span class="toggle-slider"></span></label></div>
          <div class="toggle-row"><div class="toggle-label"><strong>Incident Reports</strong><div class="toggle-desc">Residents can file and track incident reports</div></div><label class="toggle-switch"><input type="checkbox" id="setting-incidents-enabled" checked><span class="toggle-slider"></span></label></div>
          <div class="toggle-row"><div class="toggle-label"><strong>Amenity Reservations</strong><div class="toggle-desc">Residents can book amenities online</div></div><label class="toggle-switch"><input type="checkbox" id="setting-reservations-enabled" checked><span class="toggle-slider"></span></label></div>
