<!-- Manage Push Notification Integration -->
<div class="modal-overlay" id="modal-manageNotifIntegration">
  <div class="modal">
    <div class="modal-head"><h3><i class="fas fa-bell"></i> Push Notification Configuration</h3><button class="modal-close" onclick="closeModal('manageNotifIntegration')"><i class="fas fa-times"></i></button></div>
    <div class="form-group"><label>Service Provider</label><input type="text" value="Firebase Cloud Messaging (FCM)"></div>
    <div class="form-group"><label>API Key</label><input type="password" value="AIzaSyBxxxxxxxxxxxxxxxxxxx" placeholder="Firebase API key"></div>
    <div class="form-group"><label>Project ID</label><input type="text" value="lba4-hoa-notifications"></div>
    <div class="form-group"><label>Notify Residents On</label>
      <div style="display:flex;flex-direction:column;gap:8px;margin-top:4px">
        <label style="display:flex;align-items:center;gap:8px;font-weight:600;text-transform:none;letter-spacing:0"><input type="checkbox" checked> New Announcement published</label>
        <label style="display:flex;align-items:center;gap:8px;font-weight:600;text-transform:none;letter-spacing:0"><input type="checkbox" checked> Critical incident in village</label>
        <label style="display:flex;align-items:center;gap:8px;font-weight:600;text-transform:none;letter-spacing:0"><input type="checkbox" checked> New event added to calendar</label>
        <label style="display:flex;align-items:center;gap:8px;font-weight:600;text-transform:none;letter-spacing:0"><input type="checkbox"> New forum post (can be noisy)</label>
      </div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeModal('manageNotifIntegration')">Cancel</button>
      <button class="btn btn-primary" onclick="saveIntegration()"><i class="fas fa-save"></i> Save Configuration</button>
    </div>
  </div>
</div>

<!-- Add Role Modal -->
<div class="modal-overlay" id="modal-addRole">
  <div class="modal" style="max-width:420px">
    <div class="modal-head"><h3><i class="fas fa-plus"></i> Create New Role</h3><button class="modal-close" onclick="closeModal('addRole')"><i class="fas fa-times"></i></button></div>
    <div class="form-group"><label>Role Name</label><input type="text" id="add-role-name" placeholder="e.g. Security Officer, Finance Officer…"></div>
    <div class="form-group"><label>Description</label><textarea id="add-role-desc" placeholder="Brief description of what this role does…" style="min-height:60px"></textarea></div>
    <div class="form-group"><label>Starting Permissions</label>
      <select id="add-role-template">
        <option value="none">Start blank — no access</option>
        <option value="staff">Copy from Staff</option>
        <option value="view-only">View only everywhere</option>
      </select>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeModal('addRole')">Cancel</button>
      <button class="btn btn-primary" onclick="createRole()"><i class="fas fa-plus"></i> Create Role</button>
    </div>
  </div>
</div>

<!-- Rename Role Modal -->
<div class="modal-overlay" id="modal-renameRole">
  <div class="modal" style="max-width:380px">
    <div class="modal-head"><h3><i class="fas fa-pen"></i> Rename Role</h3><button class="modal-close" onclick="closeModal('renameRole')"><i class="fas fa-times"></i></button></div>
    <div class="form-group"><label>Role Name</label><input type="text" id="rename-role-input" placeholder="New role name…"></div>
    <div class="form-group"><label>Description</label><textarea id="rename-role-desc" style="min-height:60px"></textarea></div>
    <input type="hidden" id="rename-role-id">
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeModal('renameRole')">Cancel</button>
      <button class="btn btn-primary" onclick="saveRoleRename()"><i class="fas fa-save"></i> Save</button>
    </div>
  </div>
</div>

