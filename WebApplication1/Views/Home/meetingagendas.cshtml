<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Meeting Records & Governance - Laguna BelAir 4</title>
<!-- Fonts: Playfair Display + Outfit (matching advertisements) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<!-- Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- Styles -->
<link rel="stylesheet" href="meeting-agendas.css">
</head>
<body>

    <!-- ═══════════════════════════════════════
          HEADER / NAV (updated to match advertisements style)
        ═════════════════════════════════════ -->
    <div class="top-header-container">
        <!-- Logo Section -->
        <div class="logo-section">
            <a asp-controller="Home" asp-action="Index" class="logo-link">
                <img src="@(Url.Content("~/assets/LBAlogo.png"))" alt="Bel-Air Village Logo" class="logo-image">
            </a>
        </div>
        <!-- Navbar Wrapper -->
        <div class="header-center-wrapper">
            <div class="navbar-two-rows">
                <!-- Top Row: Utility Links -->
                <div class="navbar-top-row">
                    @{
                        var username = Context.Session.GetString("Username");
                        var userType = Context.Session.GetInt32("UserType") ?? 0;
                    }
                    @if (!string.IsNullOrEmpty(username))
                    {
                        <span class="nav-user">Hello, @username</span>
                        <form id="logoutForm" method="post" asp-controller="Home" asp-action="Logout" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="nav-link btn-logout">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="login"><i class="fas fa-sign-in-alt"></i> Login</a>
                        <span class="nav-separator">|</span>
                        <a asp-controller="Home" asp-action="register"><i class="fas fa-user-plus"></i> Register</a>
                    }
                </div>
                <!-- Bottom Row: Main Navigation -->
                <div class="navbar-bottom-row">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">About <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                            <a asp-controller="Home" asp-action="aboutlagunabelair">Laguna BelAir 4</a>
                            @* <a asp-controller="Home" asp-action="committeesBods">Committees/BODs</a> *@
                            <a asp-controller="Home" asp-action="landMarks">Landmarks</a>
                            <a asp-controller="Home" asp-action="contacts">Contacts</a>
                        </div>
                    </div>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">Community <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                             @* <a asp-controller="Home" asp-action="announcement">Announcements</a> *@
                            <a asp-controller="Home" asp-action="forums">Forums/Discussions</a>
                            <a asp-controller="Home" asp-action="advertisements">Advertisements</a>
                              @* <a asp-controller="Home" asp-action="calendars">Calendars</a>
                                    <a asp-controller="Home" asp-action="meetingAgendas">Meeting Record/Governance</a>
                                    <a asp-controller="Home" asp-action="communityMap">Community Map</a> *@
                        </div>
                    </div>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle">Services <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-menu">
                             <a asp-controller="Home" asp-action="reserve">Reserve Amenities</a>
                            <a asp-controller="Home" asp-action="reportConcerns">Report Concerns/Incidents</a>
                        </div>
                    </div>
                    @* <div class="dropdown">
                                <a href="#" class="dropdown-toggle">Others <i class="fas fa-chevron-down"></i></a>
                                <div class="dropdown-menu">
                                    <a asp-controller="Home" asp-action="formsDocuments">Downloadable Forms and Documents</a>
                                </div>
                            </div> *@
                </div>
            </div>
        </div>
    </div>

<!-- ═══════════════════════════════════════
  HERO SECTION (matching advertisements style with added <p>)
═══════════════════════════════════════ -->
<section class="hero-section">
  <div class="hero-inner">
    <h1 class="hero-title">Board Meeting Records & Governance</h1>
    <p class="hero-sub">Access meeting agendas, minutes, and official HOA documents <br> keeping our community transparent and informed.</p>
  </div>
</section>

<!-- ═══════════════════════════════════════
  MAIN CONTENT
═══════════════════════════════════════ -->
<main class="main-container">
  <!-- Search and Filter Section -->
  <section class="search-filter-section">
    <div class="search-card">
      <h2><i class="fas fa-search"></i> Search Records</h2>
      <div class="search-form">
        <div class="search-input-group">
          <input type="text" class="search-input" placeholder="Search meeting, keyword, or document">
        </div>
        <div class="filter-row">
          <div class="filter-group">
            <label for="year-filter">Year</label>
            <select id="year-filter" class="filter-select">
              <option value="">All Years</option>
              <option value="2026">2026</option>
              <option value="2025">2025</option>
            </select>
          </div>
          <div class="filter-group">
            <label for="type-filter">Document Type</label>
            <select id="type-filter" class="filter-select">
              <option value="">All</option>
              <option value="agenda">Agenda</option>
              <option value="minutes">Minutes</option>
              <option value="resolution">Resolution</option>
            </select>
          </div>
          <button class="search-btn"><i class="fas fa-search"></i> Search</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Upcoming Meeting Section -->
  <section class="upcoming-meeting-section">
    <h2 class="section-title"><i class="fas fa-calendar-plus"></i> Upcoming Meeting</h2>
    <div class="upcoming-meeting-card">
      <div class="meeting-info">
        <div class="info-item">
          <i class="fas fa-calendar"></i>
          <div>
            <span class="info-label">Date</span>
            <span class="info-value">March 15, 2026</span>
          </div>
        </div>
        <div class="info-item">
          <i class="fas fa-clock"></i>
          <div>
            <span class="info-label">Time</span>
            <span class="info-value">7:00 PM</span>
          </div>
        </div>
        <div class="info-item">
          <i class="fas fa-map-marker-alt"></i>
          <div>
            <span class="info-label">Location</span>
            <span class="info-value">HOA Office, Laguna BelAir 4</span>
          </div>
        </div>
      </div>
      <div class="meeting-actions">
        <button class="btn btn-primary"><i class="fas fa-file-alt"></i> View Agenda</button>
        <button class="btn btn-secondary"><i class="fas fa-calendar-plus"></i> Add to Calendar</button>
      </div>
    </div>
  </section>

  <!-- Recent Meeting Records Section -->
  <section class="recent-records-section">
    <h2 class="section-title"><i class="fas fa-history"></i> Recent Meeting Records</h2>
    <div class="table-container">
      <table class="records-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Agenda</th>
            <th>Minutes</th>
            <th>Other Documents</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td data-label="Date">January 10, 2026</td>
            <td data-label="Agenda">
              <a href="#" class="doc-link"><i class="fas fa-eye"></i> View</a>
            </td>
            <td data-label="Minutes">
              <a href="#" class="doc-link"><i class="fas fa-download"></i> Download</a>
            </td>
            <td data-label="Other Documents">
              <a href="#" class="doc-link"><i class="fas fa-file-pdf"></i> Financial Report</a>
            </td>
            <td data-label="Status">
              <span class="status-badge status-completed">Completed</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Governance Documents Section -->
  <section class="governance-section">
    <h2 class="section-title"><i class="fas fa-gavel"></i> HOA Governance & Policies</h2>
    <div class="governance-grid">
      <div class="governance-card">
        <div class="card-icon">
          <i class="fas fa-book"></i>
        </div>
        <h3>HOA By-Laws</h3>
        <p>Official rules governing the homeowners association</p>
        <div class="card-actions">
          <button class="btn btn-sm btn-primary"><i class="fas fa-eye"></i> View</button>
          <button class="btn btn-sm btn-secondary"><i class="fas fa-download"></i> Download</button>
        </div>
      </div>
      <div class="governance-card">
        <div class="card-icon">
          <i class="fas fa-clipboard-list"></i>
        </div>
        <h3>Rules and Regulations</h3>
        <p>Community guidelines and standards</p>
        <div class="card-actions">
          <button class="btn btn-sm btn-primary"><i class="fas fa-eye"></i> View</button>
          <button class="btn btn-sm btn-secondary"><i class="fas fa-download"></i> Download</button>
        </div>
      </div>
      <div class="governance-card">
        <div class="card-icon">
          <i class="fas fa-stamp"></i>
        </div>
        <h3>Board Resolutions</h3>
        <p>Official decisions and resolutions</p>
        <div class="card-actions">
          <button class="btn btn-sm btn-primary"><i class="fas fa-eye"></i> View</button>
          <button class="btn btn-sm btn-secondary"><i class="fas fa-download"></i> Download</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Meeting Archive Section -->
  <section class="archive-section">
    <h2 class="section-title"><i class="fas fa-archive"></i> Archive</h2>
    <div class="archive-card">
      <h3 class="archive-year">2025</h3>
      <ul class="archive-list">
        <li>
          <a href="#" class="archive-link">
            <i class="fas fa-folder"></i>
            <span>November Board Meeting</span>
            <span class="archive-action">View Records <i class="fas fa-chevron-right"></i></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Footer Note -->
  <div class="footer-note">
    <i class="fas fa-info-circle"></i>
    For questions or requests regarding board meeting records, please contact the HOA Office.
  </div>
</main>

