  <section class="hero-section">
    <div class="hero-inner">
      <h1 class="hero-title">Report an Issue</h1>
      <p class="hero-sub">Help us keep Laguna BelAir 4 safe and well-maintained <br> by reporting concerns or incidents you've observed.</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       MAIN CONTENT
  ═══════════════════════════════════════ -->
  <main class="page-main">

    <!-- Important Notice -->
    <div class="notice-section">
      <h2><i class="fas fa-exclamation-circle"></i> Important Notice</h2>
      <p>This form is intended for reporting non-emergency concerns or incidents within the village.</p>
      <p class="emergency-notice">If the situation involves an immediate threat to life, safety, or property, please contact emergency services right away.</p>
      <div class="emergency-contacts">
        <p><strong>Emergency Contacts:</strong></p>
        <ul>
          <li>National Emergency Hotline: 911</li>
          <li>Village Security Office: xxx-xxx-xxx</li>
        </ul>
      </div>
      <p class="submission-note">Submitted reports are reviewed during regular office hours and will be handled according to village policies and available resources.</p>
    </div>

    <!-- FORM -->
    <form class="report-form" id="reportForm" novalidate>

      <!-- Hidden fields populated by JS -->
      <input type="hidden" id="f-timestamp"  name="timestamp">
      <input type="hidden" id="f-latitude"   name="latitude">
      <input type="hidden" id="f-longitude"  name="longitude">

      <!-- ─── DESCRIBE ─── -->
      <div class="form-card" data-section="1">
        <div class="card-header">
          <div>
            <h2>Describe the Issue</h2>
            <p class="card-hint">Be as specific as possible - what happened, when, and what you observed.</p>
          </div>
        </div>

        <div class="field-block">
          <label for="f-description" class="field-label">
            What's happening? <span class="req" aria-label="required">*</span>
          </label>
          <div class="textarea-wrap">
            <textarea
              id="f-description"
              name="description"
              class="field-textarea"
              rows="6"
              maxlength="2000"
              placeholder="Describe what happened in as much detail as possible — include what you saw, heard, or noticed, and approximately when it occurred."
              required
            ></textarea>
            <span class="char-counter"><span id="char-count">0</span> / 2000</span>
          </div>
          <p class="field-note">
            <i class="fas fa-robot"></i>
            Our staff system will automatically classify the type, priority, and visibility of your report based on your description.
          </p>
        </div>

        <!-- Issue Category (optional, broad — NLP still primary) -->
        <div class="field-block">
          <label for="f-category" class="field-label">
            Issue Category
            <span class="badge-optional">Optional</span>
          </label>
          <select id="f-category" name="category" class="field-select">
            <option value="">Select a broad category (optional)</option>
            <option value="maintenance">Maintenance / Infrastructure</option>
            <option value="cleanliness">Cleanliness / Waste</option>
            <option value="safety">Safety / Hazard</option>
            <option value="security">Security Concern</option>
            <option value="noise">Noise Complaint</option>
            <option value="parking">Parking / Traffic</option>
            <option value="others">Others</option>
          </select>
          <p class="field-note">
            <i class="fas fa-circle-info"></i>
            This is a broad hint only. Our staff's NLP system will perform detailed classification regardless of your selection.
          </p>
        </div>
      </div>

      <!-- ─── LOCATION ─── -->
      <div class="form-card" data-section="2">
        <div class="card-header">
          <div>
            <h2>Location of the Concern</h2>
            <p class="card-hint">Address where the concern/incident exists (or closest to).</p>
          </div>
        </div>

        <p class="search-label">Search location by:</p>
        <div class="radio-group">
          <label class="radio-label">
            <input type="radio" name="search-type" value="address" checked onchange="toggleLocationMethod()">
            Street / Address
          </label>
          <label class="radio-label">
            <input type="radio" name="search-type" value="map" onchange="toggleLocationMethod()">
            Pin on Map
          </label>
        </div>

        <!-- Address fields -->
        <div id="address-fields" class="address-fields">
          <div class="field-row-2">
            <div class="field-block" style="margin-bottom:0;">
              <label for="f-address" class="field-label">Address</label>
              <input type="text" id="f-address" name="address" class="field-input" placeholder="House / Block number">
            </div>
            <div class="field-block" style="margin-bottom:0;">
              <label for="f-street" class="field-label">Street</label>
              <input type="text" id="f-street" name="street" class="field-input" placeholder="e.g., Alpine St.">
            </div>
          </div>
        </div>

        <!-- Map -->
        <div id="map-container" class="map-container" style="display:none;">
          <div class="map-wrapper">
            <div id="map" class="leaflet-map"></div>
            <div class="map-overlay-hint" id="mapHint">
              <i class="fas fa-hand-pointer"></i>
              <span>Click or drag the pin to mark the exact location</span>
            </div>
          </div>

          <div class="location-status" id="locationStatus" aria-live="polite">
            <i class="fas fa-circle-info"></i>
            <span id="locationStatusText">No location selected yet.</span>
          </div>

          <button type="button" class="btn-locate" id="btnLocate">
            <i class="fas fa-crosshairs"></i> Use My Current Location
          </button>
        </div>

        <!-- Additional location details (always visible) -->
        <div class="field-block" style="margin-top:20px;">
          <label for="f-additional-location" class="field-label">Additional Location Details</label>
          <input type="text" id="f-additional-location" name="additionalLocation" class="field-input"
            placeholder="e.g., Near the clubhouse, Corner of Alpine St., in front of Block 5">
        </div>
      </div>

      <!-- ─── ADDITIONAL DETAILS ─── -->
      <div class="form-card" data-section="3">
        <div class="card-header">
          <div>
            <h2>Additional Details</h2>
            <p class="card-hint">Optional — but helps our team act faster.</p>
          </div>
        </div>

        <!-- Photo Upload -->
        <div class="field-block">
          <label class="field-label" for="f-photo">
            Upload Photo
            <span class="badge-optional">Optional</span>
          </label>
          <p class="field-note" style="margin-bottom:12px;">
            <i class="fas fa-camera"></i>
            For maintenance concerns, this image may be used as a <strong>"Before"</strong> photo and shown publicly on the Community Map once resolved.
          </p>

          <div class="upload-zone" id="uploadZone" tabindex="0" role="button" aria-label="Upload photo">
            <input type="file" id="f-photo" name="photo" accept="image/*" style="display:none;">
            <div class="upload-idle" id="uploadIdle">
              <i class="fas fa-cloud-arrow-up"></i>
              <span>Click to upload or drag &amp; drop</span>
              <small>JPG, PNG, WEBP — max 10 MB</small>
            </div>
            <div class="upload-preview" id="uploadPreview" style="display:none;">
              <img id="previewImg" src="" alt="Preview">
              <button type="button" class="remove-photo" id="removePhoto" title="Remove photo">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- Anonymous -->
        <div class="field-block">
          <label class="toggle-row" for="f-anonymous">
            <div class="toggle-text">
              <span class="field-label" style="margin-bottom:2px;">Submit Anonymously</span>
              <small>Your personal information will not be shown publicly or shared with other residents.</small>
            </div>
            <div class="toggle-switch">
              <input type="checkbox" id="f-anonymous" name="anonymous" role="switch">
              <span class="toggle-thumb"></span>
            </div>
          </label>
        </div>

        <!-- Reporter (shown only when NOT anonymous) -->
        <div id="reporterSection" class="reporter-section">
          <div class="field-row-2">
            <div class="field-block" style="margin-bottom:0;">
              <label for="f-name" class="field-label">Your Name</label>
              <input type="text" id="f-name" name="reporterName" class="field-input" placeholder="Full name">
            </div>
            <div class="field-block" style="margin-bottom:0;">
              <label for="f-contact" class="field-label">Contact (optional)</label>
              <input type="text" id="f-contact" name="reporterContact" class="field-input" placeholder="Phone or email">
            </div>
          </div>
          <p class="field-note" style="margin-top:10px;">
            <i class="fas fa-lock"></i>
            Contact details are visible only to HOA staff and will not be shared publicly.
          </p>
        </div>
      </div>

      <!-- ─── SUBMIT ─── -->
      <div class="form-card submit-card" data-section="4">
        <div class="confirm-row">
          <label class="checkbox-row" for="f-confirm">
            <input type="checkbox" id="f-confirm" name="confirm" required>
            <span class="custom-check"><i class="fas fa-check"></i></span>
            <span>I confirm that the information provided is accurate to the best of my knowledge, and I understand that false reports may be subject to administrative action.</span>
          </label>
        </div>

        <button type="submit" class="btn-submit" id="btnSubmit" disabled>
          <span class="btn-submit-text">
            <i class="fas fa-paper-plane"></i>
            Submit Report
          </span>
          <span class="btn-submit-loading" style="display:none;">
            <i class="fas fa-spinner fa-spin"></i>
            Submitting…
          </span>
        </button>

        <p class="submit-note">
          Reports are reviewed during office hours. You will be notified once staff have processed your submission.
        </p>
      </div>

    </form>
  </main>

  <!-- ═══════════════════════════════════════
