          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </section>

  <!-- Online Community Services -->
  <section class="content-section">
    <h2>Online Community Services</h2>
    <div class="services-grid">
                        
      <a asp-controller="Home" asp-action="announcement" class="service-card">
        <i class="fas fa-bullhorn"></i>
        <h3>Announcements</h3>
      </a>
      <a asp-controller="Home" asp-action="reportconcerns" class="service-card">
        <i class="fas fa-exclamation-triangle"></i>
        <h3>Report Concerns / Incidents</h3>
      </a>
        <a asp-controller="Home" asp-action="reserve" class="service-card">
        <i class="fas fa-calendar-check"></i>
        <h3>Reserve Amenities</h3>
      </a>
        <a asp-controller="Home" asp-action="forums" class="service-card">
        <i class="fas fa-comments"></i>
        <h3>Forums / Discussions</h3>
      </a>
        <a asp-controller="Home" asp-action="formsdocuments" class="service-card">
        <i class="fas fa-file-download"></i>
        <h3>Downloadable Forms</h3>
