      <li><i class="fas fa-building"></i> Multi-Purpose Hall</li>
      <li><i class="fas fa-tree"></i> Parks</li>
      <li><i class="fas fa-road"></i> Village Roads & Common Areas</li>
    </ul>
  </section>

  <!-- Location -->
