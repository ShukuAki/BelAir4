        <p><i class="fas fa-map-pin"></i> Brgy. Don Jose, Santa Rosa City, Laguna</p>
        <p><i class="fas fa-phone"></i> (+63) 09398588138</p>
        <p><i class="fas fa-phone-alt"></i> 0495603050</p>
      </div>
      <div class="map-container">
