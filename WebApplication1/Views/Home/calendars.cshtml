<!-- ═══════════════════════════════════════
  HERO SECTION (matching advertisements style with added <p>)
═══════════════════════════════════════ -->
<section class="hero-section">
  <div class="hero-inner">
    <h1 class="hero-title">Community Calendar</h1>
    <p class="hero-sub">Stay on top of village events, meetings, holidays,<br> and important deadlines - all in one place.</p>
  </div>
</section>

<!-- ═══════════════════════════════════════
  MAIN CONTENT CONTAINER
═══════════════════════════════════════ -->
<div class="main-container">
  <!-- Community Calendar Section -->
  <section class="calendar-section">
    <div class="calendar-container">
      <!-- Left Side: Events List -->
      <div class="events-side">
        <div class="selected-date-display">
          <h3 id="current-date">Sunday, January 18, 2026</h3>
        </div>
        <div class="events-list">
          <h4>Events for <span id="display-date">Today</span></h4>
          <div class="events-container" id="events-container">
            <div class="no-events">
              <i class="fas fa-calendar-day"></i>
              <p>No events scheduled for this date</p>
            </div>
          </div>
        </div>
      </div>
      <!-- Right Side: Interactive Calendar -->
      <div class="calendar-side">
        <div class="calendar-header">
          <button id="prev-month"><i class="fas fa-chevron-left"></i></button>
          <h3 id="current-month-year">January 2026</h3>
          <button id="next-month"><i class="fas fa-chevron-right"></i></button>
        </div>
        <div class="calendar-weekdays">
          <div>Sun</div>
          <div>Mon</div>
          <div>Tue</div>
          <div>Wed</div>
          <div>Thu</div>
          <div>Fri</div>
          <div>Sat</div>
        </div>
        <div class="calendar-days" id="calendar-days">
          <!-- Calendar days will be generated by JavaScript -->
        </div>
      </div>
    </div>
  </section>

  <!-- Past Events Section -->
  <section class="past-events-section">
    <h2 class="section-title">Past Events</h2>
    <div class="past-events-list">
      <ul>
        <li>- List of Past Events Along with the Date</li>
        <li>- List of Past Events Along with the Date</li>
        <li>- List of Past Events Along with the Date</li>
      </ul>
    </div>
  </section>
</div>

